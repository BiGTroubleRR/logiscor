# Copy to .env.local and fill in. Never commit the real file (.env* is gitignored).

# Supabase — Project Settings → API Keys
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the "publishable" key — safe to ship to the browser, used
# only for Auth. SUPABASE_SERVICE_ROLE_KEY is the "secret" key — server-only, never exposed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Console — enable Maps JavaScript API, Directions API, Geocoding API.
# Restrict this key by HTTP referrer (it ships to the browser — the Maps JS API requires that).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
