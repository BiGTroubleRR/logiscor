# Copy to .env.local and fill in. Never commit the real file (.env* is gitignored).

# Supabase — Project Settings → API Keys
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the "publishable" key — safe to ship to the browser, used
# only for Auth. SUPABASE_SERVICE_ROLE_KEY is the "secret" key — server-only, never exposed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# No map API key needed — MapView.tsx uses Leaflet + OpenStreetMap tiles, and route search
# uses OSRM's public demo server, both free and keyless. See next.config.ts for the CSP entries.
